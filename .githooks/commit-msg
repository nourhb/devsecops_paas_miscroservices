#!/bin/sh
MSG_FILE="${1:?commit-msg hook requires path to commit message file}"
TMP="${MSG_FILE}.paas-strip"
T1=$(printf 'Co-authored-by:')
T2=$(printf 'Made-with:')

grep -vE "^(${T1}|${T2})" "$MSG_FILE" > "$TMP" 2>/dev/null || cp "$MSG_FILE" "$TMP"
mv "$TMP" "$MSG_FILE"

sed -i.bak -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$MSG_FILE" 2>/dev/null || \
  sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$MSG_FILE" > "${TMP}" 2>/dev/null && mv "${TMP}" "$MSG_FILE" || true
rm -f "${MSG_FILE}.bak" "${MSG_FILE}.paas-strip" 2>/dev/null || true
